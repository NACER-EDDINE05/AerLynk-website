{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/opengraph-image",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/opengraph-image/",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/apple-icon",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/apple-icon/",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/downloads/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
